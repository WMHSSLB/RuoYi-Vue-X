package ${packageName}.vo;

## VO只导入接口返回需要的类型，不导入@TableName、@Version等实体持久化注解。
#foreach ($import in $voImportList)
import ${import};
#end
#if($table.sub)
import java.util.List;
import ${packageName}.domain.${subClassName};
#end
import com.ruoyi.common.core.domain.BaseEntity;
import io.swagger.v3.oas.annotations.media.Schema;
import lombok.Data;
import lombok.EqualsAndHashCode;

/**
 * ${functionName}VO
 *
 * @author ${author}
 * @date ${datetime}
 */
@Schema(description = "${functionName}VO")
@Data
@EqualsAndHashCode(callSuper = false)
public class ${ClassName}Vo extends BaseEntity
{
    private static final long serialVersionUID = 1L;

#foreach ($column in $columns)
#if(!$table.isSuperColumn($column.javaField))
    /** $column.columnComment */
## DateTimeFormat保留给VO复用为查询对象时的GET绑定，JsonFormat控制JSON响应格式。
#if($column.javaType == 'LocalDate')
    @DateTimeFormat(pattern = "yyyy-MM-dd")
    @JsonFormat(pattern = "yyyy-MM-dd")
#elseif($column.javaType == 'LocalDateTime')
    @DateTimeFormat(pattern = "yyyy-MM-dd HH:mm:ss")
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
#elseif($column.javaType == 'Date')
    @JsonFormat(pattern = "yyyy-MM-dd")
#end
    private $column.javaType $column.javaField;

#end
#end
#if($table.sub)
    /** $table.subTable.functionName信息 */
    private List<${subClassName}> ${subclassName}List;

#end
}
