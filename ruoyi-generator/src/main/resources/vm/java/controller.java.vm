package ${packageName}.controller;

import java.util.List;
import jakarta.servlet.http.HttpServletResponse;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import com.ruoyi.common.annotation.Log;
import com.ruoyi.common.core.controller.BaseController;
import com.ruoyi.common.core.domain.Response;
import com.ruoyi.common.enums.BusinessType;
import ${packageName}.domain.${ClassName};
import ${packageName}.dto.${ClassName}EditDto;
import ${packageName}.dto.${ClassName}QueryDto;
import ${packageName}.dto.${ClassName}SaveDto;
import ${packageName}.service.I${ClassName}Service;
import ${packageName}.vo.${ClassName}Vo;
import com.ruoyi.common.utils.poi.ExcelUtil;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
#if($table.crud || $table.sub)
import com.ruoyi.common.core.page.TableDataInfo;
#elseif($table.tree)
#end

/**
 * ${functionName}Controller
 *
 * @author ${author}
 * @date ${datetime}
 */
// Knife4j/OpenAPI3根据@Tag将当前Controller归类到对应接口分组
@Tag(name = "${functionName}")
@RestController
@RequestMapping("/${moduleName}/${businessName}")
public class ${ClassName}Controller extends BaseController
{
    @Autowired
    private I${ClassName}Service ${className}Service;

    /**
     * 查询${functionName}列表
     */
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:list')")
    @Operation(summary = "查询${functionName}列表")
    @GetMapping("/list")
#if($table.crud || $table.sub)
    public TableDataInfo list(${ClassName}QueryDto ${className})
    {
        startPage();
        List<${ClassName}Vo> list = ${className}Service.select${ClassName}List(${className});
        return getDataTable(list);
    }
#elseif($table.tree)
    public Response<List<${ClassName}Vo>> list(${ClassName}QueryDto ${className})
    {
        List<${ClassName}Vo> list = ${className}Service.select${ClassName}List(${className});
        return Response.success(list);
    }
#end

    /**
     * 导出${functionName}列表
     */
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:export')")
    @Log(title = "${functionName}", businessType = BusinessType.EXPORT)
    @Operation(summary = "导出${functionName}列表")
    @PostMapping("/export")
    public void export(HttpServletResponse response, ${ClassName}QueryDto ${className})
    {
        List<${ClassName}> list = ${className}Service.select${ClassName}ExportList(${className});
        ExcelUtil<${ClassName}> util = new ExcelUtil<${ClassName}>(${ClassName}.class);
        // 代码生成默认使用EasyExcel导出，实体上的@ExcelProperty负责声明表头和转换器。
        // 若需要使用若依原POI导出能力，可切换为util.exportExcel(response, list, "${functionName}数据")。
        util.exportEasyExcel(response, list, "${functionName}数据");
    }

    /**
     * 获取${functionName}详细信息
     */
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:query')")
    @Operation(summary = "获取${functionName}详细信息")
    @GetMapping(value = "/{${pkColumn.javaField}}")
    public Response<${ClassName}Vo> getInfo(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField})
    {
        return Response.success(${className}Service.select${ClassName}By${pkColumn.capJavaField}(${pkColumn.javaField}));
    }

    /**
     * 新增${functionName}
     */
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:add')")
    @Log(title = "${functionName}", businessType = BusinessType.INSERT)
    @Operation(summary = "新增${functionName}")
    @PostMapping
    public Response<Void> add(@Validated @RequestBody ${ClassName}SaveDto ${className})
    {
        return Response.toResponse(${className}Service.insert${ClassName}(${className}));
    }

    /**
     * 修改${functionName}
     */
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:edit')")
    @Log(title = "${functionName}", businessType = BusinessType.UPDATE)
    @Operation(summary = "修改${functionName}")
    @PutMapping
    public Response<Void> edit(@Validated @RequestBody ${ClassName}EditDto ${className})
    {
        return Response.toResponse(${className}Service.update${ClassName}(${className}));
    }

    /**
     * 删除${functionName}
     */
    @PreAuthorize("@ss.hasPermi('${permissionPrefix}:remove')")
    @Log(title = "${functionName}", businessType = BusinessType.DELETE)
    @Operation(summary = "删除${functionName}")
	@DeleteMapping("/{${pkColumn.javaField}s}")
    public Response<Void> remove(@PathVariable ${pkColumn.javaType}[] ${pkColumn.javaField}s)
    {
        return Response.toResponse(${className}Service.delete${ClassName}By${pkColumn.capJavaField}s(${pkColumn.javaField}s));
    }
}
