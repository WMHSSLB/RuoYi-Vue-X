<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysErrorLogMapper">

    <resultMap type="SysErrorLog" id="SysErrorLogResult">
        <id     property="errorId"       column="error_id"       />
        <result property="traceId"       column="trace_id"       />
        <result property="userId"        column="user_id"        />
        <result property="userName"      column="user_name"      />
        <result property="requestUri"    column="request_uri"    />
        <result property="requestMethod" column="request_method" />
        <result property="exceptionName" column="exception_name" />
        <result property="errorMessage"  column="error_message"  />
        <result property="stackTrace"    column="stack_trace"    />
        <result property="bizType"       column="biz_type"       />
        <result property="bizId"         column="biz_id"         />
        <result property="ipaddr"        column="ipaddr"         />
        <result property="userAgent"     column="user_agent"     />
        <result property="errorTime"     column="error_time"     />
    </resultMap>

    <sql id="selectErrorLogVo">
        select error_id, trace_id, user_id, user_name, request_uri, request_method, exception_name, error_message,
               stack_trace, biz_type, biz_id, ipaddr, user_agent, error_time
        from sys_error_log
    </sql>

    <insert id="insertErrorLog" parameterType="SysErrorLog">
        insert into sys_error_log(trace_id, user_id, user_name, request_uri, request_method, exception_name,
                                  error_message, stack_trace, biz_type, biz_id, ipaddr, user_agent, error_time)
        values (#{traceId}, #{userId}, #{userName}, #{requestUri}, #{requestMethod}, #{exceptionName},
                #{errorMessage}, #{stackTrace}, #{bizType}, #{bizId}, #{ipaddr}, #{userAgent}, sysdate())
    </insert>

    <select id="selectErrorLogList" parameterType="SysErrorLog" resultMap="SysErrorLogResult">
        <include refid="selectErrorLogVo"/>
        <where>
            <if test="traceId != null and traceId != ''">
                AND trace_id = #{traceId}
            </if>
            <if test="userName != null and userName != ''">
                AND user_name like concat('%', #{userName}, '%')
            </if>
            <if test="requestUri != null and requestUri != ''">
                AND request_uri like concat('%', #{requestUri}, '%')
            </if>
            <if test="exceptionName != null and exceptionName != ''">
                AND exception_name like concat('%', #{exceptionName}, '%')
            </if>
            <if test="bizType != null and bizType != ''">
                AND biz_type = #{bizType}
            </if>
            <if test="bizId != null and bizId != ''">
                AND biz_id = #{bizId}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND error_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND error_time &lt;= #{params.endTime}
            </if>
        </where>
        order by error_id desc
    </select>

    <select id="selectErrorLogById" parameterType="Long" resultMap="SysErrorLogResult">
        <include refid="selectErrorLogVo"/>
        where error_id = #{errorId}
    </select>

    <delete id="deleteErrorLogByIds" parameterType="Long">
        delete from sys_error_log where error_id in
        <foreach collection="array" item="errorId" open="(" separator="," close=")">
            #{errorId}
        </foreach>
    </delete>

    <update id="cleanErrorLog">
        truncate table sys_error_log
    </update>

</mapper>
